# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ranking weights: final_score = RELEVANCE_WEIGHT * relevance + PAGERANK_WEIGHT * pagerank
# Should sum to 1.0, but are not required to.
RELEVANCE_WEIGHT=0.7
PAGERANK_WEIGHT=0.3

# PageRank damping factor (0 < d < 1)
PAGERANK_DAMPING=0.85
